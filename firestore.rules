rules_version = '2';

// Britannia Reports — Firestore security rules
//
// Posture: deny everything by default. Each collection is opened by the slice
// that introduces it — never pre-emptively.
//
// Open collections:
//   allowedUsers                       — S-01. Read-only, and only to the account the document names.
//   users/{uid}/reportTemplates/{id}   — S-02. Read/create/delete by the owning uid, and only while
//                                        that account is on the allowlist; never updated.
//   users/{uid}/students/{studentId}   — S-03. Read/create/update/delete by the owning uid, and only
//                                        while that account is on the allowlist. The first MUTABLE
//                                        collection here: everything above is write-once or read-only.

service cloud.firestore {
  match /databases/{database}/documents {

    // Is the caller an account the school has actually let in?
    //
    // Added 2026-07-31, closing the gap the S-02 Phase 1 review raised as F1:
    // the templates rule used to authorize on `request.auth.uid` alone, so ANY
    // Google account that completed Firebase sign-in could create, read and
    // delete under its own `users/{uid}/reportTemplates` subtree — allowlisted
    // or not. No cross-teacher leak and no student data, but the project's
    // storage and its Spark write quota were reachable by anyone holding the
    // project id, which ships in the bundle.
    //
    // That gap was first accepted on the argument that App Check enforcement
    // would close it. Enforcement did land (Phase 6), but this is the layer that
    // actually decides: rules are evaluated independently of App Check, of
    // `SessionService`, and of any future client. Defence in depth, and the only
    // half of it that fails closed.
    //
    // Cost, stated plainly: one extra document read per template operation,
    // billed against the Spark 50K reads/day budget. Template operations are
    // rare — a handful per teacher per term — so this is not the quota risk that
    // `onSnapshot` listeners are.
    //
    // Keyed on the EMAIL, because that is what `allowedUsers` is keyed on and
    // FR-003 requires seeding before a uid exists. See the two-identifier note
    // on the templates rule below.
    function isAllowlisted() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    // The FR-003 teacher allowlist.
    //
    // Document id is the user's Google address, lowercased. The only field is
    // `role`, which is either "teacher" or "director".
    //
    // Writing is closed to every caller, including the signed-in user the
    // document names: FR-003 makes seeding a developer action performed in the
    // Firebase Console, and the MVP ships no invite UI. See
    // `docs/teacher-allowlist-runbook.md` for the procedure.
    //
    // `.lower()` on the token side makes the comparison robust against a
    // differently-cased address; the runbook is what keeps the stored document
    // id lowercase. `email_verified` is free hardening — Google accounts always
    // carry it.
    match /allowedUsers/{email} {
      allow read: if request.auth != null
                  && request.auth.token.email_verified == true
                  && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // FR-009..FR-012 — per-teacher trimester/semester report templates.
    //
    // Ownership is the `{uid}` path segment, compared against the caller's own
    // `request.auth.uid`. Note this is a DIFFERENT identifier from the email the
    // allowlist above is keyed on: same person, two ids. The allowlist answers
    // "is this account allowed in at all", this answers "whose data is this".
    //
    // BOTH questions are asked here, and they are not redundant. `uid == uid`
    // alone would let any signed-in Google account use its own subtree as free
    // storage; `isAllowlisted()` alone would let one allowlisted teacher read
    // another's templates. Neither check subsumes the other.
    //
    // `update` is denied to everyone, the owner included. PRD `## Non-Goals`
    // makes templates write-once — to change one, the teacher deletes it and
    // saves a new one — so the store enforces that rather than the UI alone. It
    // is also what makes duplicate names impossible: the document id is the
    // normalized name, so a second save under the same name is a create against
    // an existing document, which fails.
    //
    // The `users/{uid}` parent document is never written and gets no rule of its
    // own; the catch-all below keeps it closed. Firestore allows a subcollection
    // under a document that does not exist.
    match /users/{uid}/reportTemplates/{templateId} {
      allow read, create, delete: if request.auth != null
                                  && request.auth.uid == uid
                                  && isAllowlisted();
      allow update: if false;
    }

    // FR-005..FR-008 — the per-teacher student roster.
    //
    // Same ownership shape as the templates rule above, and for the same reason:
    // the `{uid}` path segment IS the schema, so it cannot drift from it. Both
    // questions are asked here too — `uid == uid` answers "whose data is this",
    // `isAllowlisted()` answers "is this account allowed in at all".
    //
    // `update` is ALLOWED here, and this is the first rule in the file that allows
    // it. That is not an inconsistency with the templates rule one block up: PRD
    // `## Non-Goals` makes templates write-once (delete and re-save to change one),
    // while FR-007 makes editing a student a first-class capability. A teacher
    // fixing a misspelt surname must not have to delete the child and re-add them.
    //
    // Document ids are Firestore auto-ids, NOT the normalized name the templates
    // rule uses. A student's name is mutable (FR-007) and not unique — two children
    // may share one — so a name-keyed id would turn a rename into a non-atomic
    // delete + create and would reject a legitimate second "Jan Kowalski".
    //
    // WHAT THIS RULE DELIBERATELY DOES NOT DO: validate the document's shape.
    // Required keys, types and length caps live in `StudentsService`, not here.
    // `context/foundation/infrastructure.md` records why — a rule that restates a
    // schema drifts from it silently, and an over-permissive rule does not fail
    // loudly. The boundary that actually protects a child's record is ownership,
    // and that is what this rule enforces and what `test/rules/students.test.mjs`
    // proves. A malformed write costs its own author a broken row; it cannot reach
    // another teacher.
    match /users/{uid}/students/{studentId} {
      allow read, create, update, delete: if request.auth != null
                                          && request.auth.uid == uid
                                          && isAllowlisted();
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}

// ---------------------------------------------------------------------------
// HOW OWNERSHIP IS EXPRESSED HERE, AND WHY IT IS NOT A FIELD
// ---------------------------------------------------------------------------
//
// The templates rule compares `request.auth.uid` against a path segment. The
// obvious alternative — a flat `reportTemplates/{id}` collection with an
// `ownerUid` field and a rule reading `resource.data.ownerUid` — was rejected
// deliberately.
//
// `context/foundation/infrastructure.md` describes the failure mode concretely:
// a rule written against `teacherUid` while the documents actually carried
// `teacherId`. The comparison silently evaluated against a missing field, the
// rule silently over-permitted, and one teacher could read another teacher's
// data for a month before anyone noticed. Over-permissive rules do not fail
// loudly — that is the whole problem.
//
// A path segment cannot drift from the schema, because it IS the schema. Any
// new per-teacher collection should follow the same shape:
//
//   match /users/{uid}/<collection>/{docId} {
//     allow read, create, delete: if request.auth != null && request.auth.uid == uid;
//   }
//
// ⚠ If you ever do need an owner FIELD (a collection-group query, say), copy the
// field name from the actual document schema — not from this comment and not
// from memory — and add a rules test that fails when the names disagree.
//
// ---------------------------------------------------------------------------
// THE RULES-TESTING HARNESS EXISTS — RUN IT
// ---------------------------------------------------------------------------
//
// `npm run test:rules` starts the Firestore emulator, runs `test/rules/` against
// it, and shuts it down. It needs a JDK on the machine. It runs the WHOLE
// directory (`node --test test/rules`), so a new `.mjs` file there needs no
// config change anywhere.
//
// Coverage today — `report-templates.test.mjs`:
//
//   - teacher A reads, creates and deletes their own template
//   - teacher A is recognised whatever case the address is signed in with
//   - teacher B — also allowlisted, so this tests ownership and not the allowlist
//     — is denied read, create and delete against A's template
//   - a signed-in account that is NOT on the allowlist is denied create, read and
//     delete under its OWN uid, including when the allowlist holds some other
//     address (which is what would catch an `exists()` testing the collection
//     rather than the caller's own document)
//   - an allowlisted address whose email is unverified is denied
//   - an unauthenticated caller is denied everything
//   - update is denied, including for the owner (the write-once invariant)
//
// Coverage today — `students.test.mjs`:
//
//   - teacher A reads, creates, UPDATES and deletes their own student
//   - teacher A is recognised whatever case the address is signed in with
//   - teacher B — also allowlisted — is denied all four operations against A's
//     student, update included
//   - a signed-in account that is NOT on the allowlist is denied all four under
//     its OWN uid, including when the allowlist holds some other address
//   - an allowlisted address whose email is unverified is denied
//   - an unauthenticated caller is denied everything
//
// One emulator artefact you will see and should not chase: denials of a WRITE
// log `evaluation error at L90` rather than a plain `false`. It appeared when
// `isAllowlisted()` added a document lookup to the expression. Every outcome is
// correct — reads deny cleanly, owners are still allowed, and a create of a
// genuinely new template still succeeds — and the branches that log it were
// going to deny regardless. Verified by probe on 2026-07-31.
//
// S-01 shipped the `allowedUsers` rule above without this harness, by recorded
// decision: that rule is read-only to every caller and holds no student data, so
// the cross-teacher leak surface did not yet exist. S-02 built the harness before
// writing the rule above it, which is where that argument ran out.
//
// ⚠ EVERY TEST FILE HERE NEEDS ITS OWN `projectId`. `node --test` runs one
// process per file, in parallel, against a single emulator, and
// `initializeTestEnvironment` namespaces data and rules by project id. Two files
// sharing an id share a dataset — and each one's `clearFirestore()` in
// `afterEach` then deletes the other's fixtures mid-test. Adding
// `students.test.mjs` made a previously stable templates test fail
// intermittently on a create its own `seedAllowlist` had just made legal, which
// is how this was found. A third file needs a third id.
//
// Three things worth knowing before you change a rule here:
//
//   - The harness is NOT wired into `npm test` and there is no CI. Nothing runs
//     it for you. Run it yourself, before you deploy, every time this file
//     changes.
//   - Dev and prod share one Firebase project. `environment.ts` sets
//     `useEmulators: true` so local development no longer writes to the
//     production store — but anyone who flips that flag is back to editing real
//     teacher data from localhost.
