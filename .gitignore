# See http://help.github.com/ignore-files/ for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Firebase deploy cache (regenerated by every `firebase deploy`)
/.firebase

# Local emulator state (`npm run emulators` imports and exports it). Holds the
# seeded allowlist document that lets you sign in locally — machine-local, and
# deliberately not shared: seed your own once through the emulator UI.
/.emulator-data

# Emulator debug logs, rewritten on every emulator start
/firebase-debug.log
/firestore-debug.log
/ui-debug.log

# PDF-fidelity capture output (`npm run test:capture`). Regenerated on demand; only the committed
# references under docs/pdf-fidelity/reference/ are tracked.
/docs/pdf-fidelity/captured

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db


# Playwright CLI scratch output (snapshots, console logs) — regenerated on every run
/.playwright-cli

# Signed-in emulator session for the Playwright CLI browser (`npm run e2e:auth:save`).
# Machine-local and short-lived: it holds real Auth-emulator tokens for your own
# account, and it is worthless on another machine anyway, since the emulator data
# it points at is not shared.
/test/e2e/.auth

# Playwright run artifacts (traces, error contexts) — `npm run e2e` rewrites them
/test/e2e/.output
/playwright-report
